<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.peihua8858.AdbTools</id>

    <name>AdbTools</name>

    <vendor url="https://github.com/peihua8858">peihua8858</vendor>

    <description><![CDATA[
        ADB 综合工具箱：在 IDE 内完成设备选择、网络环境切换、埋点 UT 配置、进程管理、
        日志过滤、截图录屏、内存分析等常用 adb 调试操作，命令输出实时显示在工具窗口控制台。
    ]]></description>

    <resource-bundle>messages.MyMessageBundle</resource-bundle>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="AdbTools"
                    anchor="right"
                    factoryClass="com.peihua8858.adbtools.ui.AdbToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowPalette"/>
        <applicationService serviceImplementation="com.peihua8858.adbtools.adb.AdbSettings"/>
    </extensions>

    <actions>
        <action id="AdbTools.OpenToolWindow"
                class="com.peihua8858.adbtools.action.OpenAdbToolsAction"
                text="ADB 工具箱"
                description="打开 ADB 工具箱工具窗口"
                icon="AllIcons.Toolwindows.ToolWindowPalette">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
